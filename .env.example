# Скопируйте этот файл в .env и заполните. Файл .env никогда не попадает на GitHub.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/ВАШ_КЛЮЧ
PRIVATE_KEY=0x... # ключ ТЕСТОВОГО кошелька, без настоящих денег
ETHERSCAN_API_KEY=

# Значения Chainlink VRF v2.5 для Sepolia: https://docs.chain.link/vrf/v2-5/supported-networks
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUBSCRIPTION_ID=

# Параметры лотереи
TICKET_PRICE_ETH=0.01
FEE_PERCENT=10
ROUND_DURATION_SECONDS=86400
